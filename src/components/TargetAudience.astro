---
import config from '../data/config.json';
---

<section class="target-audience section" id="para-quien">
  <div class="container">
    <h2 class="section-title">Ideal para tu negocio</h2>
    <p class="section-subtitle">
      Factu Lite esta diseñado para emprendimientos y micro negocios en Nicaragua.
    </p>

    <div class="audience-grid">
      {config.promotional.targetAudience.map(business => (
        <div class="audience-item">
          <span class="material-icons">store</span>
          <span>{business}</span>
        </div>
      ))}
    </div>

    <div class="audience-cta">
      <p>¿No sabes si Factu Lite es para ti?</p>
      <a 
        href={`https://wa.me/${config.advisors[0].phone}?text=${encodeURIComponent(config.whatsappMessage)}`}
        class="btn btn-whatsapp btn-lg"
        target="_blank"
        rel="noopener"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Preguntar a un asesor
      </a>
    </div>
  </div>
</section>

<style>
  .target-audience {
    background-color: var(--color-surface);
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-2xl);
  }

  .audience-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-lg);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .audience-item:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .audience-item .material-icons {
    color: var(--color-primary);
    font-size: 24px;
  }

  .audience-item span:last-child {
    font-weight: 500;
    font-size: 0.875rem;
  }

  .audience-cta {
    text-align: center;
    padding: var(--spacing-2xl);
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    border: 1px dashed var(--color-border);
  }

  .audience-cta p {
    margin-bottom: var(--spacing-md);
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .audience-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767px) {
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-sm);
    }

    .audience-item {
      padding: var(--spacing-sm) var(--spacing-md);
      flex-direction: column;
      text-align: center;
    }

    .audience-item .material-icons {
      font-size: 20px;
    }

    .audience-cta {
      padding: var(--spacing-xl);
    }
  }
</style>