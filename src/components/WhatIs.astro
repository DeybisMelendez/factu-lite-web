---
import config from '../data/config.json';

const latestVersion = config.versions[0];
const recommendedApk = latestVersion.apks.find(apk => apk.recommended) || latestVersion.apks[0];
---

<section class="whatis section" id="que-es">
  <div class="container">
    <h2 class="section-title">Que es Factu Lite?</h2>
    <p class="section-subtitle">
      Una aplicación móvil diseñada para negocios pequeños que necesitan gestionar sus ventas, 
      inventario y caja sin complicaciones.
    </p>

    <div class="whatis-grid">
      <div class="whatis-card card card-hover">
        <div class="whatis-icon">
          <span class="material-icons">wifi_off</span>
        </div>
        <h3>Funciona Sin Internet</h3>
        <p>
          Ideal para tiendas, minimarkets, ferreterías y negocios en zonas con 
          conectividad limitada. Solo requiere conexión ocasional para validar la licencia.
        </p>
      </div>

      <div class="whatis-card card card-hover">
        <div class="whatis-icon">
          <span class="material-icons">security</span>
        </div>
        <h3>Datos 100% Tuyos</h3>
        <p>
          No guardamos tus datos en la nube. Toda la información se queda en tu dispositivo, 
          protegiendo tu privacidad.
        </p>
      </div>

      <div class="whatis-card card card-hover">
        <div class="whatis-icon">
          <span class="material-icons">payments</span>
        </div>
        <h3>Licencia Permanente</h3>
        <p>
          Pago único, sin mensuales. Una vez que adquieres tu licencia,
          queda activada para siempre.
        </p>
      </div>

      <div class="whatis-card card card-hover">
        <div class="whatis-icon">
          <span class="material-icons">devices</span>
        </div>
        <h3>Un Solo Dispositivo</h3>
        <p>
          Diseñado para funcionar en un solo celular o tablet. No hay sincronización 
          entre múltiples dispositivos.
        </p>
      </div>
    </div>

    <div class="trial-box">
      <div class="trial-content">
        <h3>Modo de Prueba Sin Licencia</h3>
        <p>Descarga la app y úsala gratis con todas las funcionalidades, pero con estas limitaciones:</p>
        <ul class="trial-list">
          {config.trial.limitations.map(limit => (
            <li>
              <span class="material-icons" style="font-size: 18px; color: var(--color-warning);">lock</span>
              {limit}
            </li>
          ))}
        </ul>
        <p class="trial-note">Activa tu licencia para quitar todas las limitaciones.</p>
      </div>
      <div class="trial-action">
        <div class="download-box">
          <a href={recommendedApk.url} class="btn btn-primary btn-lg" download>
            <span class="material-icons">download</span>
            Descargar v{latestVersion.version}
          </a>
          <div class="download-variants">
            {latestVersion.apks.map(apk => (
              <a 
                href={apk.url} 
                class:list={["download-variant", { recommended: apk.recommended }]}
                download
              >
                <span class="variant-name">{apk.abi}</span>
                {apk.recommended && <span class="badge-recommended">Recomendado</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .whatis {
    background-color: var(--color-surface);
  }

  .whatis-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-3xl);
  }

  .whatis-card {
    text-align: center;
    padding: var(--spacing-xl);
  }

  .whatis-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-50);
    border-radius: var(--radius-full);
  }

  .whatis-icon .material-icons {
    font-size: 32px;
    color: var(--color-primary);
  }

  .whatis-card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-sm);
  }

  .whatis-card p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .trial-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    color: white;
  }

  .trial-content h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .trial-content p {
    opacity: 0.9;
    margin-bottom: var(--spacing-md);
  }

  .trial-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .trial-list li {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .trial-note {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .trial-action .btn {
    background: white;
    color: var(--color-primary-dark);
    white-space: nowrap;
  }

  .trial-action .btn:hover {
    background: var(--color-primary-50);
    transform: translateY(-2px);
  }

  .download-box {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .download-variants {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    justify-content: center;
  }

  .download-variant {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: 4px 10px;
    font-size: 0.75rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.2);
    color: white;
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .download-variant:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  .download-variant.recommended {
    background: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .variant-name {
    font-family: monospace;
    font-weight: 600;
  }

  .badge-recommended {
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--color-warning);
    color: var(--color-text);
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    .whatis-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .whatis-grid {
      grid-template-columns: 1fr;
    }

    .trial-box {
      flex-direction: column;
      text-align: center;
    }

    .trial-list {
      align-items: flex-start;
      display: inline-flex;
      text-align: left;
    }

    .trial-action {
      width: 100%;
    }

    .trial-action .btn {
      width: 100%;
    }
  }
</style>
