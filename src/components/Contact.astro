---
import config from '../data/config.json';

const whatsappBase = 'https://wa.me/';
---

<section class="contact section" id="contacto">
  <div class="container">
    <h2 class="section-title">Habla con un Asesor</h2>
    <p class="section-subtitle">
      Nuestro equipo esta listo para ayudarte a elegir el mejor plan para tu negocio.
    </p>

    <div class="advisors-grid">
      {config.advisors.map(advisor => (
        <div class="advisor-card card card-hover">
          <div class="advisor-avatar">
            {advisor.avatar ? (
              <img src={advisor.avatar} alt={advisor.name} width="80" height="80" />
            ) : (
              <div class="avatar-placeholder">
                <span class="material-icons">person</span>
              </div>
            )}
          </div>
          <h3 class="advisor-name">{advisor.name}</h3>
          <p class="advisor-role">Asesor de ventas</p>
          <a 
            href={`${whatsappBase}${advisor.phone}?text=${encodeURIComponent(config.whatsappMessage)}`}
            class="btn btn-whatsapp"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Contactar por WhatsApp
          </a>
        </div>
      ))}
    </div>

    <div class="contact-note">
      <p>
        <span class="material-icons" style="font-size: 18px; vertical-align: middle;">schedule</span>
        Horario de atencion: Lunes a Viernes de 8:00 AM a 6:00 PM (hora de Nicaragua)
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-bg);
  }

  .advisors-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl);
    max-width: 700px;
    margin: 0 auto var(--spacing-xl);
  }

  .advisor-card {
    text-align: center;
    padding: var(--spacing-2xl);
  }

  .advisor-avatar {
    margin-bottom: var(--spacing-md);
  }

  .advisor-avatar img {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    object-fit: cover;
    margin: 0 auto;
  }

  .avatar-placeholder {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }

  .avatar-placeholder .material-icons {
    font-size: 40px;
    color: var(--color-text-muted);
  }

  .advisor-name {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }

  .advisor-role {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }

  .advisor-card .btn {
    width: 100%;
  }

  .contact-note {
    text-align: center;
    padding: var(--spacing-lg);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    max-width: 500px;
    margin: 0 auto;
  }

  .contact-note p {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .advisors-grid {
      grid-template-columns: 1fr;
      max-width: 350px;
    }
  }
</style>
