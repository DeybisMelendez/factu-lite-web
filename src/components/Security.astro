---
const virusTotalUrl = "https://www.virustotal.com/gui/file/fd42e6c8b77737fd56ce578d12707f92964f81920aac1f2bfe38c951b452962c/details";
const detections = "0/67";
const sha256Hash = "fd42e6c8b77737fd56ce578d12707f92964f81920aac1f2bfe38c951b452962c";
---

<section class="security">
  <div class="container">
    <div class="security-card">
      <div class="security-header">
        <div class="security-icon">
          <span class="material-icons">verified_user</span>
        </div>
        <h2 class="security-title">Descarga Segura</h2>
      </div>

      <p class="security-description">
        Esta APK ha sido analizada con VirusTotal, utilizando multiples motores antivirus para garantizar tu seguridad.
      </p>

      <div class="security-result">
        <div class="result-badge">
          <span class="material-icons result-icon">check_circle</span>
          <span class="result-text">
            <strong>{detections}</strong> detecciones
          </span>
        </div>
        <p class="result-note">Archivo libre de virus y malware</p>
      </div>

      <div class="security-actions">
        <a
          href={virusTotalUrl}
          class="btn btn-security"
          target="_blank"
          rel="noopener"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          Ver analisis completo en VirusTotal
        </a>
      </div>

      <div class="security-hash">
        <p class="hash-label">Hash SHA-256 del archivo:</p>
        <code class="hash-value">{sha256Hash}</code>
      </div>

      <p class="security-note">
        Puedes verificar la integridad del archivo comparando el hash SHA-256 de tu descarga con el mostrado arriba.
      </p>
    </div>
  </div>
</section>

<style>
  .security {
    background: linear-gradient(135deg, #10B981 0%, #059669 50%, #047857 100%);
    padding: var(--spacing-3xl) 0;
  }

  .security-card {
    background: white;
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    box-shadow: var(--shadow-xl);
  }

  .security-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .security-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .security-icon .material-icons {
    font-size: 48px;
    color: white;
  }

  .security-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
  }

  .security-description {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-xl);
  }

  .security-result {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .result-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .result-icon {
    font-size: 28px;
    color: #10B981;
  }

  .result-text {
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .result-text strong {
    color: #10B981;
    font-weight: 800;
  }

  .result-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .security-actions {
    margin-bottom: var(--spacing-xl);
  }

  .btn-security {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: white;
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: var(--radius-lg);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-security:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    color: white;
  }

  .btn-security svg {
    flex-shrink: 0;
  }

  .security-hash {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .hash-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--spacing-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .hash-value {
    font-family: monospace;
    font-size: 0.8125rem;
    color: var(--color-text);
    word-break: break-all;
    display: block;
  }

  .security-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .security {
      padding: var(--spacing-2xl) 0;
    }

    .security-card {
      padding: var(--spacing-lg);
    }

    .security-title {
      font-size: 1.5rem;
    }

    .btn-security {
      width: 100%;
      justify-content: center;
    }
  }
</style>
