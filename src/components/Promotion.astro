---
import config from '../data/config.json';

const promo = config.promotion;
---

{promo.active && (
  <section class="promotion">
    <div class="container">
      <div class="promo-box">
        <div class="promo-badge-limit">
          <span class="material-icons" style="font-size: 16px;">schedule</span>
          {promo.badge}
        </div>

        <div class="promo-content">
          <div class="promo-icon">
            <span class="material-icons">local_shipping</span>
          </div>
          <div class="promo-text">
            <h3>{promo.description}</h3>
            <p>{promo.condition}</p>
          </div>
        </div>

        <div class="promo-details">
          <div class="promo-item">
            <span class="material-icons">print</span>
            <span>Impresora termica portatil</span>
          </div>
          <div class="promo-item">
            <span class="material-icons">bluetooth</span>
            <span>Conectividad Bluetooth</span>
          </div>
          <div class="promo-item">
            <span class="material-icons">battery_charging_full</span>
            <span>Bateria recargable</span>
          </div>
        </div>

        <a 
          href={`https://wa.me/${config.advisors[0].phone}?text=${encodeURIComponent('Hola! Me interesa la promocion de la impresora termica gratis con la licencia anual de Factu Lite')}`}
          class="btn btn-primary btn-lg"
          target="_blank"
          rel="noopener"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Quiero mi impresora gratis
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .promotion {
    background: linear-gradient(135deg, #10B981 0%, #059669 50%, #047857 100%);
    padding: var(--spacing-2xl) 0;
  }

  .promo-box {
    text-align: center;
    color: white;
    position: relative;
  }

  .promo-badge-limit {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    background: rgba(255, 255, 255, 0.2);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .promo-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .promo-icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
  }

  .promo-icon .material-icons {
    font-size: 48px;
  }

  .promo-text h3 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: var(--spacing-xs);
  }

  .promo-text p {
    font-size: 1.125rem;
    opacity: 0.9;
  }

  .promo-details {
    display: flex;
    justify-content: center;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
    flex-wrap: wrap;
  }

  .promo-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.9375rem;
    opacity: 0.9;
  }

  .promo-item .material-icons {
    font-size: 24px;
  }

  .promo-box .btn {
    background: white;
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .promo-box .btn:hover {
    background: var(--color-primary-50);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 767px) {
    .promo-content {
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .promo-text h3 {
      font-size: 1.5rem;
    }

    .promo-details {
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .promo-box .btn {
      width: 100%;
    }
  }
</style>
