---
import config from "../data/config.json";
---

<section class="faq section" id="faq">
  <div class="container">
    <h2 class="section-title">Preguntas Frecuentes</h2>
    <p class="section-subtitle">
      Resolvemos las dudas mas comunes sobre Factu Lite.
    </p>

    <div class="faq-list">
      {
        config.faq.map((item, index) => (
          <details class="faq-item card" name="faq">
            <summary class="faq-question">
              <span class="faq-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="faq-text">{item.question}</span>
              <span class="faq-icon material-icons">expand_more</span>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>

    <div class="playstore-info-box">
      <h3>
        <span class="material-icons" style="font-size: 24px; vertical-align: middle;">info</span>
        Por que Factu Lite no esta en Google Play Store?
      </h3>
      <p class="playstore-intro">
        No subimos Factu Lite a Google Play Store para evitar cobros importantes que encarecerian el precio de la app:
      </p>
      <ul class="playstore-list">
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Comision del 30% de Google por cada venta</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Impuestos altos en Estados Unidos</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Comisiones por transferencias wire transfer para retirar lo pagado</span>
        </li>
      </ul>
      <p class="playstore-conclusion">
        Al evitar estos costos podemos mantener Factu Lite economica y especializada para pequenos negocios en Nicaragua.
      </p>
      <a
        href={`https://wa.me/${config.advisors[0].phone}?text=${encodeURIComponent('Hola! Tengo una pregunta sobre por que Factu Lite no esta en Google Play Store')}`}
        class="btn btn-whatsapp btn-sm"
        target="_blank"
        rel="noopener"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Preguntar sobre este tema
      </a>
    </div>

    <div class="install-guide-box">
      <h3>
        <span class="material-icons" style="font-size: 24px; vertical-align: middle;">smartphone</span>
        Guia de instalacion APK
      </h3>
      <p class="install-intro">
        Para instalar Factu Lite en tu Android necesitas seguir estos pasos:
      </p>
      <ol class="install-steps">
        <li>
          <span class="step-number">1</span>
          <div class="step-content">
            <strong>Ve a Ajustes</strong>
            <span>Abre la aplicacion de Configuracion de tu celular</span>
          </div>
        </li>
        <li>
          <span class="step-number">2</span>
          <div class="step-content">
            <strong>Busca Seguridad o Privacidad</strong>
            <span>El nombre varia selon el celular</span>
          </div>
        </li>
        <li>
          <span class="step-number">3</span>
          <div class="step-content">
            <strong>Activa Fuentes desconocidas</strong>
            <span>Habilita la opcion para tu navegador o para 'Instalar apps desconocidas'</span>
          </div>
        </li>
        <li>
          <span class="step-number">4</span>
          <div class="step-content">
            <strong>Descarga la APK</strong>
            <span>Presiona el boton de descarga en esta pagina</span>
          </div>
        </li>
        <li>
          <span class="step-number">5</span>
          <div class="step-content">
            <strong>Abre el archivo APK</strong>
            <span>Ve a Descargas y abre el archivo</span>
          </div>
        </li>
        <li>
          <span class="step-number">6</span>
          <div class="step-content">
            <strong>Presiona Instalar</strong>
            <span>Acepta los permisos si tu celular lo pide</span>
          </div>
        </li>
      </ol>
    </div>

    <div class="limitations-box">
      <h3>
        <span
          class="material-icons"
          style="font-size: 24px; vertical-align: middle;">info</span
        >
        Limitaciones a considerar
      </h3>
      <ul class="limitations-list">
        <li>
          <span class="material-icons text-warning">block</span>
          <span
            >Solo disponible para dispositivos Android (no funciona en
            iPhone/iPad)</span
          >
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span
            >Funciona en un solo dispositivo (sin sincronizacion entre
            dispositivos)</span
          >
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span
            >Sin acceso remoto (no puedes ver tus ventas desde otro lugar)</span
          >
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin reportes graficos o dashboards visuales</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin categorias de productos</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin multiples usuarios o perfiles con permisos</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Solo disponible en espanol</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin integraciones con otros sistemas</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .faq {
    background-color: var(--color-surface);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-3xl);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .faq-item {
    padding: 0;
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 1rem;
    transition: background-color var(--transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background-color: var(--color-surface);
  }

  .faq-number {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.7;
  }

  .faq-text {
    flex: 1;
  }

  .faq-icon {
    font-size: 24px;
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--spacing-lg) var(--spacing-lg);
    padding-left: calc(var(--spacing-lg) + var(--spacing-md) + 2ch);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .faq-answer p {
    margin: 0;
  }

  .limitations-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    max-width: 800px;
    margin: 0 auto;
  }

  .limitations-box h3 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-lg);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .limitations-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .limitations-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .limitations-list .material-icons {
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  @media (max-width: 767px) {
    .limitations-list {
      grid-template-columns: 1fr;
    }
  }

  .playstore-info-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    max-width: 800px;
    margin: 0 auto var(--spacing-2xl);
  }

  .playstore-info-box h3 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .playstore-intro {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .playstore-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .playstore-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .playstore-list .material-icons {
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .playstore-conclusion {
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: var(--spacing-lg);
  }

  .playstore-info-box .btn {
    display: inline-flex;
  }

  .install-guide-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    max-width: 800px;
    margin: 0 auto var(--spacing-2xl);
  }

  .install-guide-box h3 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .install-intro {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }

  .install-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .install-steps li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  .step-number {
    width: 32px;
    height: 32px;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 4px;
  }

  .step-content strong {
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .step-content span {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .playstore-info-box,
    .install-guide-box {
      padding: var(--spacing-lg);
    }
  }
</style>

<script lang="js">
  document.querySelectorAll("details.faq-item").forEach((details) => {
    details.addEventListener("toggle", () => {
      if (details.open) {
        document
          .querySelectorAll("details.faq-item[open]")
          .forEach((openDetails) => {
            if (openDetails !== details) {
              openDetails.removeAttribute("open");
            }
          });
      }
    });
  });
</script>
