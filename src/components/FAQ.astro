---
import config from '../data/config.json';
---

<section class="faq section" id="faq">
  <div class="container">
    <h2 class="section-title">Preguntas Frecuentes</h2>
    <p class="section-subtitle">
      Resolvemos las dudas mas comunes sobre Factu Lite.
    </p>

    <div class="faq-list">
      {config.faq.map((item, index) => (
        <details class="faq-item card" name="faq">
          <summary class="faq-question">
            <span class="faq-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="faq-text">{item.question}</span>
            <span class="faq-icon material-icons">expand_more</span>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="limitations-box">
      <h3>
        <span class="material-icons" style="font-size: 24px; vertical-align: middle;">info</span>
        Limitaciones a considerar
      </h3>
      <ul class="limitations-list">
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Solo disponible para dispositivos Android (no funciona en iPhone/iPad)</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Funciona en un solo dispositivo (sin sincronizacion entre dispositivos)</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin acceso remoto (no puedes ver tus ventas desde otro lugar)</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin reportes graficos o dashboards visuales</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin categorias de productos</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin multiples usuarios o perfiles con permisos</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Solo disponible en espanol</span>
        </li>
        <li>
          <span class="material-icons text-warning">block</span>
          <span>Sin integraciones con otros sistemas</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .faq {
    background-color: var(--color-surface);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-3xl);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .faq-item {
    padding: 0;
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 1rem;
    transition: background-color var(--transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background-color: var(--color-surface);
  }

  .faq-number {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.7;
  }

  .faq-text {
    flex: 1;
  }

  .faq-icon {
    font-size: 24px;
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--spacing-lg) var(--spacing-lg);
    padding-left: calc(var(--spacing-lg) + var(--spacing-md) + 2ch);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .faq-answer p {
    margin: 0;
  }

  .limitations-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    max-width: 800px;
    margin: 0 auto;
  }

  .limitations-box h3 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-lg);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .limitations-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .limitations-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .limitations-list .material-icons {
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  @media (max-width: 767px) {
    .limitations-list {z
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const faqItems = document.querySelectorAll('details.faq-item');

  faqItems.forEach((item) => {
    const details = item as HTMLDetailsElement;

    details.addEventListener('toggle', () => {
      if (details.open) {
        faqItems.forEach((otherItem) => {
          const otherDetails = otherItem as HTMLDetailsElement;

          if (otherDetails !== details) {
            otherDetails.removeAttribute('open');
          }
        });
      }
    });
  });
</script>
