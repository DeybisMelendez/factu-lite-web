---
import config from '../data/config.json';

const { currency, plans } = config.pricing;
---

<section class="pricing section" id="precios">
  <div class="container">
    <h2 class="section-title">Planes y Licencias</h2>
    <p class="section-subtitle">
      Elige el plan que mejor se adapte a tu negocio. Sin costos ocultos.
    </p>

    <div class="pricing-grid">
      {plans.map(plan => (
        <div class={`pricing-card card ${plan.popular ? 'popular' : ''}`}>
          {plan.popular && (
            <div class="popular-badge">
              <span class="material-icons" style="font-size: 14px;">star</span>
              Mas popular
            </div>
          )}
          {plan.promo && config.promotion.active && (
            <div class="promo-badge">
              <span class="material-icons" style="font-size: 14px;">card_giftcard</span>
              {config.promotion.badge}
            </div>
          )}
          
          <div class="pricing-header">
            <h3 class="plan-name">{plan.name}</h3>
            <p class="plan-duration">{plan.duration}</p>
          </div>
          
          <div class="pricing-price">
            <span class="currency">{currency}</span>
            <span class="amount">{plan.price.toLocaleString()}</span>
          </div>
          
          <ul class="plan-features">
            {plan.features.map(feature => (
              <li class={feature.toLowerCase().includes('impresora') ? 'feature-promo' : ''}>
                <span class="material-icons">{feature.toLowerCase().includes('impresora') ? 'card_giftcard' : 'check'}</span>
                {feature}
              </li>
            ))}
          </ul>
          
          <a 
            href={`https://wa.me/${config.advisors[0].phone}?text=${encodeURIComponent(`Hola! Me interesa el plan ${plan.name} de Factu Lite (${currency}${plan.price})`)}`}
            class={`btn ${plan.popular ? 'btn-primary' : 'btn-secondary'}`}
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Solicitar plan
          </a>
        </div>
      ))}
    </div>

    <div class="pricing-note">
      <p>
        <span class="material-icons" style="font-size: 18px; vertical-align: middle;">info</span>
        Todos los planes incluyen soporte por WhatsApp y actualizaciones. 
        Los precios son en Cordobas Nicaraguenses (C$) y no incluyen impuestos aplicables.
      </p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background-color: var(--color-bg);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
    align-items: start;
  }

  .pricing-card {
    position: relative;
    padding: var(--spacing-2xl);
    text-align: center;
    border: 2px solid transparent;
    transition: all var(--transition-normal);
  }

  .pricing-card.popular {
    border-color: var(--color-primary);
    transform: scale(1.05);
    box-shadow: var(--shadow-xl);
  }

  .popular-badge,
  .promo-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .popular-badge {
    background: var(--color-primary);
    color: white;
  }

  .promo-badge {
    top: -36px;
    background: linear-gradient(135deg, #F59E0B 0%, #EF4444 100%);
    color: white;
  }

  .pricing-header {
    margin-bottom: var(--spacing-lg);
  }

  .plan-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .plan-duration {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .pricing-price {
    margin-bottom: var(--spacing-xl);
  }

  .currency {
    font-size: 1.25rem;
    font-weight: 600;
    vertical-align: top;
    color: var(--color-text-muted);
  }

  .amount {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1;
  }

  .plan-features {
    text-align: left;
    margin-bottom: var(--spacing-xl);
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) 0;
    font-size: 0.9375rem;
    border-bottom: 1px solid var(--color-border);
  }

  .plan-features li:last-child {
    border-bottom: none;
  }

  .plan-features .material-icons {
    font-size: 20px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .plan-features .feature-promo {
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .plan-features .feature-promo .material-icons {
    color: #F59E0B;
  }

  .pricing-card .btn {
    width: 100%;
  }

  .pricing-card.popular .btn-primary {
    background: var(--color-primary);
  }

  .pricing-note {
    text-align: center;
    padding: var(--spacing-lg);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .pricing-note p {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto var(--spacing-xl);
    }

    .pricing-card.popular {
      transform: none;
      order: -1;
    }
  }
</style>
